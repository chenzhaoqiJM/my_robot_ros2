<mujoco model="myrobot_diff_lidar">
  <compiler angle="radian" coordinate="local"/>
  <option timestep="0.01" gravity="0 0 -9.81" integrator="RK4"/>

  <default>
    <geom friction="1.0 0.01 0.001" contype="0" conaffinity="0" rgba="0.8 0.8 0.8 1"/>
    <joint damping="0.1"/>
  </default>

  <asset>
    <material name="yellow" rgba="1 0.55 0 1"/>
    <material name="black" rgba="0.02 0.02 0.02 1"/>
    <material name="gray" rgba="0.55 0.55 0.55 1"/>
    <material name="red" rgba="0.8 0.1 0.1 1"/>
    <material name="blue" rgba="0.1 0.25 0.85 1"/>
    <material name="green" rgba="0.1 0.55 0.25 1"/>
    <material name="orange" rgba="0.9 0.35 0.05 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" size="8 8 0.1" material="gray" contype="1" conaffinity="1"/>

    <body name="base" pos="0 0 0.08">
      <freejoint name="base_free_joint"/>
      <geom name="base_geom" type="cylinder" size="0.10 0.035" material="yellow" mass="1.0" contype="0" conaffinity="0"/>
      <site name="laser_site" pos="0.07 0 0.045" size="0.01" rgba="0 0 1 1"/>
      <site name="imu_site" pos="0 0 0.045" size="0.01" rgba="0 1 0 1"/>

      <body name="left_wheel" pos="0 0.1125 -0.04" euler="1.57079632679 0 0">
        <joint name="left_wheel_joint" type="hinge" axis="0 0 1"/>
        <geom name="left_wheel_geom" type="cylinder" size="0.04 0.0125" material="black" mass="0.2" contype="0" conaffinity="0"/>
      </body>

      <body name="right_wheel" pos="0 -0.1125 -0.04" euler="1.57079632679 0 0">
        <joint name="right_wheel_joint" type="hinge" axis="0 0 1"/>
        <geom name="right_wheel_geom" type="cylinder" size="0.04 0.0125" material="black" mass="0.2" contype="0" conaffinity="0"/>
      </body>
    </body>

    <geom name="box_front" type="box" pos="2.0 0.0 0.25" size="0.08 0.8 0.25" material="red"/>
    <geom name="box_left" type="box" pos="0.0 1.5 0.25" size="1.2 0.08 0.25" material="red"/>
    <geom name="box_right" type="box" pos="-1.2 -1.0 0.25" size="0.08 1.0 0.25" material="red"/>

    <geom name="wall_north" type="box" pos="0.0 3.4 0.25" size="3.6 0.06 0.25" material="blue"/>
    <geom name="wall_south_left" type="box" pos="-2.2 -3.1 0.25" size="1.4 0.06 0.25" material="blue"/>
    <geom name="wall_south_right" type="box" pos="2.2 -3.1 0.25" size="1.4 0.06 0.25" material="blue"/>
    <geom name="wall_west" type="box" pos="-3.4 0.2 0.25" size="0.06 2.6 0.25" material="blue"/>
    <geom name="wall_east" type="box" pos="3.4 -0.4 0.25" size="0.06 2.8 0.25" material="blue"/>

    <geom name="corridor_left" type="box" pos="-0.85 -2.0 0.25" size="0.06 0.9 0.25" material="green"/>
    <geom name="corridor_right" type="box" pos="0.85 -2.0 0.25" size="0.06 0.9 0.25" material="green"/>
    <geom name="corridor_end" type="box" pos="0.0 -2.9 0.25" size="0.85 0.06 0.25" material="green"/>

    <geom name="pillar_northwest" type="cylinder" pos="-2.2 2.2 0.3" size="0.18 0.3" material="orange"/>
    <geom name="pillar_northeast" type="cylinder" pos="2.6 1.8 0.3" size="0.22 0.3" material="orange"/>
    <geom name="pillar_southwest" type="cylinder" pos="-2.7 -1.9 0.3" size="0.16 0.3" material="orange"/>
    <geom name="pillar_southeast" type="cylinder" pos="2.4 -2.2 0.3" size="0.2 0.3" material="orange"/>

    <geom name="short_barrier_center" type="box" pos="0.3 0.65 0.2" size="0.55 0.05 0.2" euler="0 0 0.6" material="green"/>
    <geom name="short_barrier_west" type="box" pos="-2.0 0.7 0.2" size="0.55 0.05 0.2" euler="0 0 -0.45" material="green"/>
    <geom name="short_barrier_east" type="box" pos="2.6 0.8 0.2" size="0.5 0.05 0.2" euler="0 0 -0.7" material="green"/>

    <geom name="corner_block_nw" type="box" pos="-3.0 3.0 0.25" size="0.35 0.35 0.25" material="red"/>
    <geom name="corner_block_se" type="box" pos="3.0 -3.0 0.25" size="0.35 0.35 0.25" material="red"/>
  </worldbody>

  <actuator>
    <velocity name="left_wheel_velocity" joint="left_wheel_joint" kv="10" ctrlrange="-30 30"/>
    <velocity name="right_wheel_velocity" joint="right_wheel_joint" kv="10" ctrlrange="-30 30"/>
  </actuator>

  <sensor>
    <framequat name="imu_quat" objtype="site" objname="imu_site"/>
    <gyro name="imu_gyro" site="imu_site"/>
    <accelerometer name="imu_accel" site="imu_site"/>
  </sensor>
</mujoco>
