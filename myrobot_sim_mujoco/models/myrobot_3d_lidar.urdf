<?xml version="1.0"?>
<robot name="myrobot_diff_bot_3d_lidar">
  <link name="base_footprint"/>
  <link name="base_link"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/>
    <origin xyz="0 0 0.059" rpy="0 0 0"/>
  </joint>
  <link name="lidar3d_link"/>
  <joint name="lidar3d_joint" type="fixed">
    <parent link="base_link"/><child link="lidar3d_link"/>
    <origin xyz="0.07 0 0.085" rpy="0 0 0"/>
  </joint>
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/><child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="left_wheel_link"/>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="left_wheel_link"/>
    <origin xyz="0 0.1125 -0.04" rpy="0 0 0"/><axis xyz="0 1 0"/>
  </joint>
  <link name="right_wheel_link"/>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="right_wheel_link"/>
    <origin xyz="0 -0.1125 -0.04" rpy="0 0 0"/><axis xyz="0 1 0"/>
  </joint>
</robot>